{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Provisional frozen source manifestation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_id",
    "url",
    "retrieved_utc",
    "sha256",
    "source_type",
    "status"
  ],
  "properties": {
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "url": {
      "type": "string",
      "minLength": 1
    },
    "retrieved_utc": {
      "type": "string",
      "format": "date-time"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source_type": {
      "type": "string",
      "enum": [
        "primary",
        "secondary"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "CANDIDATE",
        "VERIFIED",
        "REJECTED",
        "UNRESOLVED"
      ]
    },
    "publication_date": {
      "type": [
        "string",
        "null"
      ]
    },
    "effective_date": {
      "type": [
        "string",
        "null"
      ]
    },
    "supersedes_source_id": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
